# ==============================================================
# MOKHTAR GYM — environment variables
# Copy this file to .env for local development.
# On Vercel: set the SAME keys in Project → Settings → Environment
# Variables (values are listed in VERCEL-DEPLOY.md).
# ==============================================================

# ---- Database -------------------------------------------------
# Local development (SQLite file, data lives next to the repo):
DATABASE_URL="file:./db/custom.db"

# Production on Vercel (Turso remote database):
# DATABASE_URL="libsql://your-db-name-your-org.turso.io"
# DATABASE_AUTH_TOKEN="eyJhbGciOiJF..."

# ---- Sessions & secret encryption -----------------------------
# Derives JWT signing key + AES-256-GCM key for encrypted settings.
# Keep the SAME value across deployments, otherwise users are
# logged out and saved SMTP credentials must be re-entered once.
AUTH_SECRET="generate-a-long-random-string-here"

# ---- Email (Brevo) --------------------------------------------
# Vercel/serverless: SMTP ports are blocked, so we send through
# the Brevo HTTP API instead. Create the key in Brevo →
# SMTP & API → API Keys (it starts with "xkeysib-").
# BREVO_API_KEY="xkeysib-..."

# Local/VPS: SMTP settings (host, port, user, password, sender)
# are managed from the app itself (Admin → Settings → Auth).
